    {
      "level": 8,
      "id": "phonics-l08",
      "text": "Listen to the short vowel in bed. bed. pen. head. step. Listen and compare. pen. pin. bed. bad. Now try the sentence. Meg left her red pen on the desk.",
      "sampleCount": 5
    },
    {
      "level": 9,
      "id": "phonics-l09",
      "text": "Listen to the short vowel in sun. sun. cup. bus. lunch. Listen and compare. cup. cap. luck. lock. Now try the sentence. The duck runs under the bus.",
      "sampleCount": 5
    },
    {
      "level": 10,
      "id": "phonics-l10",
      "text": "Join the sounds into a word. Listen for the final consonant. map. sit. bed. hot. Listen and compare. cap. cat. hop. hot. Now try the sentence. Kim can hop and run.",
      "sampleCount": 5
